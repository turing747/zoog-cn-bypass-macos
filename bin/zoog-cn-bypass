#!/bin/zsh -f

set -u
umask 022

unset IFS CDPATH ENV BASH_ENV ZDOTDIR DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH LD_PRELOAD
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export LC_ALL=C

readonly VERSION="1.1.0"
readonly ROUTE_LABEL="com.local.zoog-cn-bypass"
readonly DNS_LABEL="com.local.zoog-cn-dns"
readonly INSTALL_DIR="/Library/Application Support/ZoogCNBypass"
readonly IMMUTABLE_CLI="$INSTALL_DIR/zoog-cn-bypass"
readonly CLI_PATH="/usr/local/bin/zoog-cn-bypass"
readonly ROUTE_PLIST="/Library/LaunchDaemons/$ROUTE_LABEL.plist"
readonly DNS_PLIST="/Library/LaunchDaemons/$DNS_LABEL.plist"
readonly RUN_DIR="/var/run/$ROUTE_LABEL"
readonly STATE_FILE="$RUN_DIR/state"
readonly ACTIVE_V4="$RUN_DIR/active-v4"
readonly ACTIVE_V6="$RUN_DIR/active-v6"
readonly ACTIVE_OVERRIDE_V4="$RUN_DIR/active-override-v4"
readonly ACTIVE_PINNED_HOSTS="$RUN_DIR/active-pinned-hosts"
readonly ERROR_FILE="$RUN_DIR/error"
readonly UPSTREAM_SERVERS_FILE="$INSTALL_DIR/upstream-servers.conf"
readonly CLASH_TUN_IP="198.18.0.1"
readonly DNS_STATE_KEY="State:/Network/Service/com.local.zoog-cn-bypass/DNS"
readonly CORP_DNS_KEY_PATTERN='State:/Network/Service/com[.]local[.]zoog-cn-bypass[.]corp[.][0-9]+/DNS'

# Prints one "<domains> -> <server>" line per active corporate DNS resolver.
corp_dns_status() {
  local key

  for key in $(/usr/bin/printf '%s\n' "list $CORP_DNS_KEY_PATTERN" quit | /usr/sbin/scutil 2>/dev/null \
      | /usr/bin/awk '$NF ~ /^State:/ { print $NF }'); do
    /usr/bin/printf '%s\n' "show $key" quit | /usr/sbin/scutil 2>/dev/null | /usr/bin/awk '
      $1 == "ServerAddresses" { section = "server"; next }
      $1 == "SupplementalMatchDomains" { section = "domains"; next }
      /<array>|<dictionary>|^ *}/ { section = ""; next }
      section == "server" && $2 == ":" && server == "" { server = $3 }
      section == "domains" && $2 == ":" { domains = domains (domains == "" ? "" : " ") $3 }
      END { if (server != "") print domains " -> " server }
    '
  done
}

service_is_loaded() {
  /bin/launchctl print "system/$1" >/dev/null 2>&1
}

zoog_status() {
  /usr/sbin/scutil --nc status ZoogVPN 2>/dev/null | /usr/bin/head -n 1
}

zoog_utun_interface() {
  local uuid iface=""
  local utun_pattern='^utun[0-9]+$'

  uuid="$(/usr/sbin/scutil --nc list 2>/dev/null | /usr/bin/awk '
    /\(Connected\)/ && $0 ~ /"ZoogVPN"/ {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[0-9A-Fa-f]{8}-([0-9A-Fa-f]{4}-){3}[0-9A-Fa-f]{12}$/) {
          print $i
          exit
        }
      }
    }
  ')"
  if [[ -n "$uuid" ]]; then
    iface="$(/usr/bin/printf '%s\n' "show State:/Network/Service/$uuid/IPv4" quit \
      | /usr/sbin/scutil 2>/dev/null \
      | /usr/bin/awk '$1 == "InterfaceName" && $2 == ":" { print $3; exit }')"
  fi
  if [[ ! "$iface" =~ $utun_pattern ]]; then
    iface="$(/usr/sbin/netstat -rn -f inet | /usr/bin/awk -v clash_ip="$CLASH_TUN_IP" '
      ($1 == "0/1" || ($1 == "default" && $3 !~ /I/)) && $NF ~ /^utun[0-9]+$/ && $2 != clash_ip {
        print $NF
        exit
      }
    ')"
  fi
  [[ "$iface" =~ $utun_pattern ]] && print -r -- "$iface"
}

clash_tun_interface() {
  local iface
  local utun_pattern='^utun[0-9]+$'

  iface="$(/sbin/ifconfig 2>/dev/null | /usr/bin/awk -v clash_ip="$CLASH_TUN_IP" '
    /^[a-z0-9]+:/ {
      current = $1
      sub(/:$/, "", current)
    }
    current ~ /^utun[0-9]+$/ && $1 == "inet" && $2 == clash_ip {
      print current
      exit
    }
  ')"
  [[ "$iface" =~ $utun_pattern ]] || return 1

  /usr/sbin/netstat -rn -f inet | /usr/bin/awk -v clash_ip="$CLASH_TUN_IP" -v target="$iface" '
    $2 == clash_ip && $NF == target { found = 1; exit }
    END { exit(found ? 0 : 1) }
  ' || return 1

  print -r -- "$iface"
}

upstream_dns_summary() {
  if [[ -r "$UPSTREAM_SERVERS_FILE" ]]; then
    /usr/bin/awk -F= '/^server=/ { list = list (list == "" ? "" : ", ") $2 } END { print list }' "$UPSTREAM_SERVERS_FILE"
  fi
}

dns_override_is_active() {
  local definition

  definition="$(/usr/bin/printf '%s\n' "show $DNS_STATE_KEY" quit | /usr/sbin/scutil 2>/dev/null)"
  [[ "$definition" == *"0 : 127.0.0.1"* ]]
}

resolve_ipv4() {
  /usr/bin/dig +time=2 +tries=1 +short @127.0.0.1 "$1" A 2>/dev/null | /usr/bin/awk '
    /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { address = $0 }
    END { print address }
  '
}

route_interface() {
  /sbin/route -n get "$1" 2>/dev/null | /usr/bin/awk '/interface:/ { print $2; exit }'
}

line_count() {
  if [[ -r "$1" ]]; then
    /usr/bin/wc -l < "$1" | /usr/bin/tr -d ' '
  else
    print 0
  fi
}

status_command() {
  local vpn_status zoog_iface="" clash_iface="" clash_status active_tunnel
  local route_service dns_service split_status routing_status upstream_summary
  local cn_interface foreign_interface domestic_ip foreign_ip domestic_route foreign_route
  local corp_dns corp_line override_count pinned_count

  vpn_status="$(zoog_status)"
  [[ -n "$vpn_status" ]] || vpn_status="Unavailable"
  if [[ "$vpn_status" == "Connected" ]]; then
    zoog_iface="$(zoog_utun_interface 2>/dev/null || true)"
  fi

  clash_iface="$(clash_tun_interface 2>/dev/null || true)"
  if [[ -n "$clash_iface" ]]; then
    clash_status="Connected ($clash_iface)"
  else
    clash_status="Disconnected"
  fi

  if [[ "$vpn_status" == "Connected" ]]; then
    if [[ -n "$clash_iface" ]]; then
      active_tunnel="ZoogVPN (${zoog_iface:-utun}, priority over Clash Pro $clash_iface)"
    else
      active_tunnel="ZoogVPN (${zoog_iface:-utun})"
    fi
  elif [[ -n "$clash_iface" ]]; then
    active_tunnel="Clash Pro ($clash_iface)"
  else
    active_tunnel="none"
  fi

  if service_is_loaded "$ROUTE_LABEL"; then
    route_service="loaded"
  else
    route_service="not loaded"
  fi
  if service_is_loaded "$DNS_LABEL"; then
    dns_service="loaded"
  else
    dns_service="not loaded"
  fi
  if dns_override_is_active; then
    split_status="active"
  else
    split_status="inactive"
  fi

  if [[ -r "$STATE_FILE" ]]; then
    if [[ "$vpn_status" == "Connected" || -n "$clash_iface" ]]; then
      routing_status="active"
    else
      routing_status="standby (routes retained for fast reconnect)"
    fi
  else
    routing_status="inactive"
  fi

  upstream_summary="$(upstream_dns_summary)"
  override_count="$(line_count "$ACTIVE_OVERRIDE_V4")"
  pinned_count="$(line_count "$ACTIVE_PINNED_HOSTS")"

  print -- "ZoogVPN: $vpn_status"
  print -- "Clash Pro TUN: $clash_status"
  print -- "Active foreign tunnel: $active_tunnel"
  print -- "Route service: $route_service"
  print -- "Local DNS service: $dns_service"
  print -- "Split DNS override: $split_status"
  print -- "Foreign DNS upstream: ${upstream_summary:-default}"
  print -- "China-direct routing: $routing_status"
  print -- "Installed IPv4 routes: $(line_count "$ACTIVE_V4")"
  print -- "Installed IPv6 routes: $(line_count "$ACTIVE_V6")"
  if (( override_count > 0 )); then
    print -- "Priority override routes: $override_count"
  fi
  if (( pinned_count > 0 )); then
    print -- "Pinned corporate gateways: $pinned_count"
  fi

  corp_dns="$(corp_dns_status)"
  if [[ -n "$corp_dns" ]]; then
    for corp_line in "${(@f)corp_dns}"; do
      print -r -- "Corporate DNS: active ($corp_line)"
    done
  else
    print -- "Corporate DNS: inactive (no corporate DNS server reachable)"
  fi

  if [[ -r "$ERROR_FILE" ]]; then
    print -- "Last error: $(<"$ERROR_FILE")"
  fi

  cn_interface="$(route_interface 223.5.5.5)"
  foreign_interface="$(route_interface 1.1.1.1)"
  print -- "Route check — China 223.5.5.5: ${cn_interface:-unknown}"
  print -- "Route check — foreign 1.1.1.1: ${foreign_interface:-unknown}"

  if service_is_loaded "$DNS_LABEL"; then
    domestic_ip="$(resolve_ipv4 www.baidu.com)"
    foreign_ip="$(resolve_ipv4 www.cloudflare.com)"
    domestic_route=""
    foreign_route=""
    [[ -n "$domestic_ip" ]] && domestic_route="$(route_interface "$domestic_ip")"
    [[ -n "$foreign_ip" ]] && foreign_route="$(route_interface "$foreign_ip")"
    print -- "DNS check — www.baidu.com: ${domestic_ip:-unresolved} via ${domestic_route:-unknown}"
    print -- "DNS check — www.cloudflare.com: ${foreign_ip:-unresolved} via ${foreign_route:-unknown}"
  fi
}

verify_root_owned() {
  local target="$1"

  [[ -e "$target" && ! -L "$target" ]] || return 1
  [[ "$(/usr/bin/stat -f '%u:%Lp' "$target" 2>/dev/null)" == "0:755" ]]
}

run_with_admin() {
  local action="$1"

  case "$action" in
    enable|disable|uninstall) ;;
    *)
      print -u 2 -- "Invalid privileged action: $action"
      return 64
      ;;
  esac

  if ! verify_root_owned "$INSTALL_DIR" || ! verify_root_owned "$IMMUTABLE_CLI"; then
    print -u 2 -- "Security check failed: $IMMUTABLE_CLI is missing or not owned by root:wheel (0755)."
    return 69
  fi

  /usr/bin/osascript \
    -e 'on run argv' \
    -e 'set toolPath to item 1 of argv' \
    -e 'set toolAction to item 2 of argv' \
    -e 'return do shell script ("/bin/zsh -f " & quoted form of toolPath & " " & quoted form of toolAction) with administrator privileges' \
    -e 'end run' \
    -- "$IMMUTABLE_CLI" "$action"
}

require_root() {
  local action="$1"

  if [[ "$(/usr/bin/id -u)" -ne 0 ]]; then
    run_with_admin "$action"
    exit $?
  fi
}

bootstrap_service() {
  local label="$1"
  local plist="$2"
  local mode="${3:-}"

  /bin/launchctl enable "system/$label"
  if ! service_is_loaded "$label"; then
    /bin/launchctl bootstrap system "$plist"
    return
  fi

  if [[ "$mode" == "restart" ]]; then
    /bin/launchctl kickstart -k "system/$label"
  else
    /bin/launchctl kickstart "system/$label" >/dev/null 2>&1 || true
  fi
}

wait_for_dns() {
  local attempt

  for attempt in {1..30}; do
    if [[ -n "$(resolve_ipv4 www.baidu.com)" ]]; then
      return 0
    fi
    /bin/sleep 1
  done
  return 1
}

wait_for_active_split() {
  local attempt

  for attempt in {1..120}; do
    if [[ -r "$STATE_FILE" ]] && dns_override_is_active && [[ -n "$(resolve_ipv4 www.baidu.com)" ]]; then
      return 0
    fi
    /bin/sleep 1
  done
  return 1
}

enable_command() {
  local clash_iface=""

  require_root enable

  if ! verify_root_owned "$INSTALL_DIR" || ! verify_root_owned "$INSTALL_DIR/dnsmasq" || ! verify_root_owned "$INSTALL_DIR/daemon.sh"; then
    print -u 2 -- "ZoogCNBypass is not installed securely (root-owned binaries required). Re-run ./install.sh."
    return 69
  fi

  "$INSTALL_DIR/dnsmasq" --test --conf-file="$INSTALL_DIR/dnsmasq.conf" >/dev/null
  bootstrap_service "$DNS_LABEL" "$DNS_PLIST" restart
  bootstrap_service "$ROUTE_LABEL" "$ROUTE_PLIST" restart

  clash_iface="$(clash_tun_interface 2>/dev/null || true)"
  if [[ "$(zoog_status)" == "Connected" ]]; then
    print -- "ZoogVPN is connected; waiting for China routes and split DNS..."
    if ! wait_for_active_split; then
      print -u 2 -- "Activation timed out. Run: zoog-cn-bypass status"
      return 1
    fi
    print -- "ZoogCNBypass enabled and active (foreign tunnel: ZoogVPN)."
  elif [[ -n "$clash_iface" ]]; then
    print -- "Clash Pro TUN ($clash_iface) is connected; waiting for China routes and split DNS..."
    if ! wait_for_active_split; then
      print -u 2 -- "Activation timed out. Run: zoog-cn-bypass status"
      return 1
    fi
    print -- "ZoogCNBypass enabled and active (foreign tunnel: Clash Pro $clash_iface)."
  else
    if ! wait_for_dns; then
      print -u 2 -- "The local DNS service did not become ready."
      return 1
    fi
    print -- "ZoogCNBypass enabled. It will activate when ZoogVPN or Clash Pro (Enhanced Mode) connects."
  fi
}

disable_internal() {
  /bin/launchctl bootout "system/$ROUTE_LABEL" >/dev/null 2>&1 || true
  /bin/launchctl disable "system/$ROUTE_LABEL"

  if verify_root_owned "$INSTALL_DIR/daemon.sh"; then
    print -- "Removing recorded routes, DNS overrides, and restoring proxy settings..."
    "$INSTALL_DIR/daemon.sh" stop || true
  fi

  /bin/launchctl bootout "system/$DNS_LABEL" >/dev/null 2>&1 || true
  /bin/launchctl disable "system/$DNS_LABEL"
}

disable_command() {
  require_root disable
  disable_internal
  print -- "ZoogCNBypass disabled. ZoogVPN / Clash Pro / UniVPN connections were not disconnected."
}

uninstall_command() {
  require_root uninstall
  disable_internal

  /bin/unlink "$ROUTE_PLIST" 2>/dev/null || true
  /bin/unlink "$DNS_PLIST" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/daemon.sh" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/zoog-cn-bypass" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/cn-ipv4.txt" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/cn-ipv6.txt" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/dnsmasq.conf" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/upstream-servers.conf" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/corp-dns.conf" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/accelerated-domains.china.conf" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/apple.china.conf" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/dnsmasq" 2>/dev/null || true
  /bin/unlink "$INSTALL_DIR/VERSION" 2>/dev/null || true
  /bin/rmdir "$INSTALL_DIR" 2>/dev/null || true
  /bin/rm -rf -- "$RUN_DIR" 2>/dev/null || true
  /usr/bin/chflags nouchg "$CLI_PATH" 2>/dev/null || true
  /bin/unlink "$CLI_PATH" 2>/dev/null || true

  print -- "ZoogCNBypass uninstalled. Homebrew dnsmasq was left installed."
}

usage() {
  print -- "Usage: zoog-cn-bypass <command>"
  print -- ""
  print -- "Commands:"
  print -- "  enable      Enable automatic China-direct, UniVPN, and ZoogVPN/Clash split routing"
  print -- "  disable     Disable persistently without disconnecting your VPNs"
  print -- "  status      Show tunnels, services, routes, DNS, and live routing checks"
  print -- "  uninstall   Remove the helper, routes, DNS override, and services"
  print -- "  version     Print the installed version"
}

case "${1:-}" in
  enable)
    enable_command
    ;;
  disable)
    disable_command
    ;;
  status)
    status_command
    ;;
  uninstall)
    uninstall_command
    ;;
  version|--version|-v)
    print -- "$VERSION"
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    print -u 2 -- "Unknown command: $1"
    usage >&2
    exit 64
    ;;
esac
